<div class="ec-rw-wrap" id="EcRw-{{ block.id }}">
  <div class="ec-drawer">
    <button class="ec-close" aria-label="Close">✕</button>
    <div class="ec-inner">
      <div class="ec-badge">EL CIRCLE 88 PRIVÉ</div>
      <h3 class="ec-title">The Rewards of <span>Sovereign Status</span></h3>
      <p class="ec-sub">Earn 1 point for every $1 spent. Accumulate assets to step into higher-tier privileges and exclusive pricing allocations.</p>
      
      <div class="ec-track">
        <span class="ec-node active">Pearl</span><span class="ec-sep">→</span>
        <span class="ec-node">Silver</span><span class="ec-sep">→</span>
        <span class="ec-node gold">Gold Only</span><span class="ec-sep">→</span>
        <span class="ec-node vip">Infinite</span>
      </div>
      
      <div class="ec-btn-box">
        {% if customer %}
          <a href="https://dashboard-customer.myshopify.com/pages/reward-page" class="ec-btn">
            <span>ENTER REWARDS DASHBOARD</span> →
          </a>
        {% else %}
          <a href="{{ routes.account_register_url }}" class="ec-btn">
            <span>JOIN NOW & EARN 25 POINTS</span> →
          </a>
        {% endif %}
      </div>
      
      <p class="ec-foot">
        {% if customer %}
          Welcome back, {{ customer.first_name }}. Your tier multipliers are active.
        {% else %}
          Membership is complimentary. Already registered? <a href="{{ routes.account_login_url }}">Sign in</a>
        {% endif %}
      </p>
    </div>
  </div>

  <div class="ec-bar">
    <div class="ec-bar-cnt">
      <span class="ec-dot"></span>
      <span>JOIN THE CLUB: SIGN UP TO EARN REWARDS</span>
    </div>
    <span class="ec-toggle">▲</span>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const wrapper = document.querySelector("#EcRw-{{ block.id }}");
  if (!wrapper) return;
  const bar = wrapper.querySelector(".ec-bar");
  const drawer = wrapper.querySelector(".ec-drawer");
  const toggle = wrapper.querySelector(".ec-toggle");
  
  const close = (e) => {
    if(e) e.stopPropagation();
    drawer.classList.remove("open");
    toggle.textContent = "▲";
  };
  
  bar.addEventListener("click", () => {
    if (drawer.classList.contains("open")) {
      close();
    } else {
      drawer.classList.add("open");
      toggle.textContent = "▼";
    }
  });
  wrapper.querySelector(".ec-close").addEventListener("click", close);
});
</script>

<style>
#EcRw-{{ block.id }} {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --gold: #b99544; --black: #111111; --white: #ffffff;
  position: fixed; bottom: 0; left: 0; width: 100%; z-index: 2147483647; display: flex; flex-direction: column;
}
.ec-bar {
  background: var(--black); color: var(--white); width: 100%; padding: 16px 24px;
  display: flex; justify-content: space-between; align-items: center; cursor: pointer;
  box-sizing: border-box; letter-spacing: 2px; font-size: 11px; font-weight: 600;
  border-top: 1px solid rgba(185,149,68,0.2); box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
}
.ec-bar-cnt { display: flex; align-items: center; gap: 10px; margin: 0 auto; }
.ec-dot { width: 5px; height: 5px; background: var(--gold); border-radius: 50%; }
.ec-toggle { font-size: 10px; color: var(--gold); }
.ec-drawer {
  background: var(--white); width: 100%; max-height: 0; overflow: hidden;
  position: relative; transition: max-height 0.4s cubic-bezier(0.25, 1, 0.3, 1);
  border-top-left-radius: 20px; border-top-right-radius: 20px; box-sizing: border-box;
}
.ec-drawer.open { max-height: 400px; border-top: 1px solid rgba(0,0,0,0.05); }
.ec-inner { max-width: 550px; margin: 0 auto; padding: 40px 24px 30px 24px; text-align: center; box-sizing: border-box; }
.ec-close { position: absolute; top: 20px; right: 24px; background: none; border: none; font-size: 16px; color: #999; cursor: pointer; }
.ec-badge { font-size: 9px; font-weight: 700; letter-spacing: 3px; color: var(--gold); margin-bottom: 12px; }
.ec-title { margin: 0; font-size: 28px; color: var(--black); font-weight: 600; }
.ec-title span { font-style: italic; color: var(--gold); font-weight: 400; }
.ec-sub { font-size: 13px; color: #555; margin: 12px 0 20px 0; line-height: 1.6; }
.ec-track { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; padding: 6px 14px; background: #fbfbfa; border-radius: 20px; border: 1px solid #f0f0ee; }
.ec-node { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: #aaa; font-weight: 500; }
.ec-node.active { color: var(--black); font-weight: 700; }
.ec-node.gold { color: var(--gold); font-weight: 700; }
.ec-node.vip { font-weight: 700; color: #555; }
.ec-sep { font-size: 9px; color: #ddd; }
.ec-btn-box { display: flex; justify-content: center; margin-bottom: 16px; }
.ec-btn {
  background: var(--black); color: var(--white); padding: 14px 32px; border-radius: 40px;
  font-size: 11px; font-weight: 700; letter-spacing: 2px; text-decoration: none;
  display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  transition: all 0.2s ease;
}
.ec-btn:hover { background: var(--gold); transform: translateY(-2px); }
.ec-foot { font-size: 12px; color: #777; margin: 0; }
.ec-foot a { color: var(--black); font-weight: 700; text-decoration: none; border-bottom: 1px solid var(--black); }
</style>

{% schema %}
{
  "name": "Sticky Rewards",
  "target": "body",
  "settings": []
}
{% endschema %}