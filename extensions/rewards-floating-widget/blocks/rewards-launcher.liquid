{% comment %}
  Care Rewards Widget - Premium Luxury Minimalist Layout
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap');

/* ==========================================================================
   1. ISOLATION RESET  & BASE FONTS
   ========================================================================== */
#care-rewards-root * {
  box-sizing: border-box !important;
  margin: 0 !important;
  padding: 40 !important;
}

#care-rewards-root {
  font-family: 'Plus Jakarta Sans', sans-serif !important;
  color: #111111 !important;
  -webkit-font-smoothing: antialiased !important;
}

.care-serif { 
  font-family: 'Cormorant Garamond', serif !important;
  font-weight: 300 !important;
  letter-spacing: -0.01em !important;
}

/* ==========================================================================
   2. LAUNCH BUTTON & OVERLAY
   ========================================================================== */
.care-floating-btn {
  position: fixed !important;
  bottom: 80px !important;
  right: 32px !important;
  z-index: 99999 !important;
  background: #111111 !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 16px 28px !important;
  display: flex !important;
  align-items: center !important;
  cursor: pointer !important;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;
  letter-spacing: 0.15em !important;
  font-size: 11px !important;
  text-transform: uppercase !important;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease !important;
}

.care-floating-btn:hover {
  background: #222222 !important;
  transform: translateY(-2px) !important;
}

.care-overlay {
  position: fixed !important;
  inset: 0 !important;
  background: rgba(0, 0, 0, 0.2) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  opacity: 0 !important;
  visibility: hidden !important;
  transition: opacity 0.4s ease, visibility 0.4s ease !important;
  z-index: 999998 !important;
}

.care-overlay.show {
  opacity: 1 !important;
  visibility: visible !important;
}

/* ==========================================================================
   3. SIDE PANEL DRAWER FRAME
   ========================================================================== */
.care-drawer {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  width: 460px !important;
  max-width: 100vw !important;
  height: 100vh !important;
  background: #ffffff !important;
  z-index: 999999 !important;
  transform: translateX(100%) !important;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  box-shadow: -20px 0 60px rgba(0, 0, 0, 0.05) !important;
}

.care-drawer.open {
  transform: translateX(0) !important;
}

/* ==========================================================================
   4. FIXED HEADER HERO CONTAINER
   ========================================================================== */
.care-top-section {
  position: relative !important;
  padding: 85px 40px 40px 40px !important;
  background: #ffffff !important;
  border-bottom: 1px solid #f2f2f2 !important;
  flex-shrink: 0 !important;
  width: 100% !important;
}

.care-program-heading {
  font-size: 10px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.25em !important;
  color: #8c8c8c !important;
  margin-bottom: 32px !important;
  font-weight: 500 !important;
  display: block !important;
}

.care-close-btn {
  position: absolute !important;
  top: 32px !important;
  right: 40px !important;
  background: none !important;
  border: none !important;
  cursor: pointer !important;
  font-size: 18px !important;
  color: #111111 !important;
  transition: transform 0.3s ease !important;
}

.care-close-btn:hover {
  transform: rotate(90deg) !important;
}

.care-header-row {
  display: flex !important;
  justify-content: space-between !important;
  align-items: flex-end !important;
  width: 100% !important;
}

.care-label {
  font-size: 11px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.2em !important;
  color: #8c8c8c !important;
  margin-bottom: 8px !important;
}

#care-points {
  font-size: 76px !important;
  color: #b08a3c !important;
  line-height: 1.0 !important;
  font-weight: 300 !important;
}


.care-header-tier {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  background: #ffffff !important;
  border: 1px solid #b08a3c !important;
  padding: 12px 18px !important;
  margin-bottom: 6px !important;
  border-radius: 8px !important;
}

.care-tier-icon {
  width: 42px !important;
  height: 42px !important;
  min-width: 42px !important;
  min-height: 42px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0 !important;
}

.care-tier-icon img {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
  display: block !important;
}

.care-tier-meta {
  display: flex !important;
  flex-direction: column !important;
}

.care-tier-label {
  font-size: 9px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.12em !important;
  color: #999999 !important;
}

.care-tier-name {
  font-size: 13px !important;
  font-weight: 600 !important;
  color: #111111 !important;
}

/* ==========================================================================
   5. VIEW NAVIGATION CANVAS
   ========================================================================== */
.care-body {
  padding: 20px 40px 40px 40px !important;
  overflow-y: auto !important;
  flex-grow: 1 !important;
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
}

.care-body::-webkit-scrollbar {
  width: 4px !important;
}

.care-body::-webkit-scrollbar-thumb {
  background: #e5e5e5 !important;
}

.care-view-panel {
  display: none !important;
  width: 100% !important;
  animation: careFadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
}

.care-view-panel.active {
  display: flex !important;
  flex-direction: column !important;
}

@keyframes careFadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

.care-back-btn {
  display: inline-flex !important;
  align-items: center !important;
  background: none !important;
  border: none !important;
  color: #8c8c8c !important;
  cursor: pointer !important;
  font-size: 11px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.15em !important;
  align-self: flex-start !important;
  padding-bottom: 2px !important;
  border-bottom: 1px solid transparent !important;
  margin-bottom: 36px !important;
  margin-top: 10px !important;
  transition: all 0.25s ease !important;
}

.care-back-btn:hover {
  color: #111111 !important;
  border-bottom-color: #111111 !important;
}

/* ==========================================================================
   6. PREMIUM SEAMLESS ROW LISTS
   ========================================================================== */
.care-card {
  background: transparent !important;
  border: none !important;
  border-bottom: 1px solid #eeeeee !important;
  padding: 26px 0 !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  cursor: pointer !important;
  width: 100% !important;
  text-decoration: none !important;
  transition: border-color 0.3s ease !important;
}

.care-card:hover {
  border-bottom-color: #111111 !important;
}

.care-card-left {
  display: flex !important;
  align-items: center !important;
  gap: 20px !important;
  text-align: left !important;
  flex-grow: 1 !important;
  padding-right: 16px !important;
}

.care-emoji {
  font-size: 16px !important;
  color: #555555 !important;
  width: 24px !important;
  text-align: left !important;
  display: inline-block !important;
  flex-shrink: 0 !important;
}

.care-card h3 {
  font-size: 21px !important;
  font-weight: 400 !important;
  color: #111111 !important;
  margin-bottom: 4px !important;
  line-height: 1.2 !important;
}

.care-card p {
  color: #777777 !important;
  font-size: 13px !important;
  font-weight: 400 !important;
  line-height: 1.4 !important;
}

.care-arrow {
  font-size: 20px !important;
  color: #b3b3b3 !important;
  flex-shrink: 0 !important;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease !important;
}

.care-card:hover .care-arrow {
  color: #b08a3c !important;
  transform: translateX(4px) !important;
}

/* ==========================================================================
   7. INTERNAL CONTENT VIEW MODULES
   ========================================================================== */
.care-sub-title {
  font-size: 36px !important;
  color: #111111 !important;
  margin-bottom: 12px !important;
  font-weight: 300 !important;
  text-align: left !important;
  line-height: 1.1 !important;
}

.care-sub-desc {
  font-size: 14px !important;
  color: #666666 !important;
  margin-bottom: 28px !important;
  line-height: 1.6 !important;
  text-align: left !important;
}

.care-list-item {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  padding: 22px 0 !important;
  border-bottom: 1px solid #eeeeee !important;
  width: 100% !important;
}

.care-item-meta {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
  text-align: left !important;
}

.care-item-meta h4 {
  font-size: 18px !important;
  font-weight: 400 !important;
  color: #111111 !important;
  line-height: 1.3 !important;
}

.care-item-meta p {
  font-size: 13px !important;
  color: #777777 !important;
}

.care-badge {
  font-size: 11px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.08em !important;
  color: #8c8c8c !important;
  font-weight: 500 !important;
}

.care-badge.action-required {
  color: #b08a3c !important;
  cursor: pointer !important;
  border-bottom: 1px solid #b08a3c !important;
  transition: opacity 0.2s ease !important;
}

.care-badge.action-required:hover {
  opacity: 0.7 !important;
}

/* PROGRESS BAR GRAPHICS */
.care-progress-container {
  margin: 12px 0 32px 0 !important;
  width: 100% !important;
}

.care-progress-track {
  width: 100% !important;
  height: 2px !important;
  background: #eeeeee !important;
  margin-top: 14px !important;
}

.care-progress-bar {
  width: 75% !important;
  height: 100% !important;
  background: #b08a3c !important;
}

/* HISTORICAL ACTIVITY RECORDS */
.care-activity-row {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  padding: 20px 0 !important;
  font-size: 14px !important;
  border-bottom: 1px solid #f7f7f7 !important;
  width: 100% !important;
}

.care-activity-date {
  color: #999999 !important;
  font-size: 12px !important;
  text-transform: uppercase !important;
}

.care-action-btn {
  width: 100% !important;
  background: #111111 !important;
  color: #ffffff !important;
  border: none !important;
  padding: 18px !important;
  font-size: 11px !important;
  font-weight: 500 !important;
  letter-spacing: 0.15em !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  transition: background 0.3s ease !important;
}

.care-action-btn:hover {
  background: #2b2b2b !important;
}

/* ==========================================================================
   8. MOBILE ADAPTIVE VIEWPORTS
   ========================================================================== */
@media (max-width: 480px) {
  .care-top-section { 
    padding: 64px 24px 28px 24px !important; 
  }
  .care-program-heading {
    margin-bottom: 24px !important;
  }
  .care-body { 
    padding: 10px 24px 32px 24px !important; 
  }
  #care-points { 
    font-size: 58px !important; 
  }
  .care-sub-title { 
    font-size: 30px !important; 
  }
  .care-floating-btn { 
    bottom: 20px !important; 
    right: 20px !important; 
    padding: 14px 24px !important; 
  }
  .care-header-tier {
    padding: 10px 14px !important;
  }
}
</style>

{% if request.page_type == 'index' %}
  <div id="care-rewards-root"></div>

  <script>
    window.CareRewardsConfig = {
      customerEmail: {{ customer.email | default: "" | json }}
    };
  </script>

  <script src="{{ 'care-rewards.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Care Rewards Widget",
  "target": "body",
  "settings": []
}
{% endschema %}